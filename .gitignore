# ─── Dependencies ───
node_modules/
**/node_modules/
.pnp
.pnp.js

# ─── Build output ───
dist/
**/dist/
dist-ssr/
build/
.vite/
*.tsbuildinfo

# ─── Environment & secrets ───
.env
.env.local
.env.*.local
**/.env
!.env.example
!**/.env.example

# ─── Logs ───
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# ─── Test / coverage ───
coverage/
# Playwright writes failure traces, screenshots and HTML reports here. A single
# trace.zip is megabytes and they are regenerated on every run, so they must
# never reach a commit.
e2e/test-results/
e2e/playwright-report/
**/test-results/
**/playwright-report/
.nyc_output/

# ─── Editor / OS ───
.DS_Store
.idea/
.vscode/
*.swp
*.local

# ─── Docker / runtime ───
mongo_data/
*.pid

# Local TLS material. Dev certs are generated by nginx/generate-dev-certs.sh;
# production certs come from certbot and must never be committed.
nginx/certs/
nginx/certbot-webroot/
