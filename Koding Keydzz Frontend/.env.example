# ─────────────────────────────────────────────────────────────────────────────
# Koding Keydzz — Student frontend (Vite) environment template.
# Copy to .env for local dev:  cp .env.example .env
#
# IMPORTANT: Vite inlines VITE_* variables at BUILD TIME. Changing them requires
# a rebuild — they are NOT read at runtime. For Vercel, set these in the project's
# Environment Variables (Production + Preview), then redeploy.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the backend API, including the /api/v1 prefix.
#   Local (non-docker) backend:  http://localhost:5500/api/v1
#   Docker-compose backend:      http://localhost:5000/api/v1
#   Behind the bundled nginx proxy (same origin): /api/v1
#   Production:                   https://api.kodingkeydzz.com/api/v1
VITE_API_URL=http://localhost:5500/api/v1

# Optional explicit Socket.IO origin. If unset, it is derived from VITE_API_URL
# by stripping the trailing /api/v1. Only set this if the realtime server lives
# on a different origin than the REST API.
# VITE_SOCKET_URL=https://api.kodingkeydzz.com

# ---- Python engine (Pyodide) ----
# Where the in-browser Python runtime is loaded from. Defaults to the public
# jsDelivr CDN when unset.
#
# SELF-HOSTING IS STRONGLY RECOMMENDED FOR SCHOOLS, for two reasons:
#   1. School networks routinely block public CDNs. When jsDelivr is filtered,
#      every Python lesson fails with "couldn't load the Python engine".
#   2. Pyodide is ~10 MB per device. Served from your own origin it is cached
#      by the proxy instead of crossing the school's uplink thirty times when a
#      class starts.
#
# To self-host: copy the Pyodide release's `full/` directory to
#   public/pyodide/v0.26.4/full/
# then set:
# VITE_PYODIDE_URL=/pyodide/v0.26.4/full/
