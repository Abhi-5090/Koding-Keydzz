# ---------------------------------------------------------------------------
# Koding Keydzz Backend — environment configuration
# Copy this file to `.env` and fill in real values. Vars marked (required) must
# be set or the server refuses to boot (see src/config/env.js).
# ---------------------------------------------------------------------------

# App
NODE_ENV=development                 # development | production | test
PORT=5000                            # HTTP port the API listens on

# Database (required)
MONGO_URI=mongodb://127.0.0.1:27017/koding_keydzz
# Optional DB connection tuning (read in src/config/db.js):
# MONGO_MAX_RETRIES=5                 # connection attempts before giving up
# MONGO_DNS_FALLBACK=on               # set to "off" to disable public-DNS SRV fallback

# Auth / JWT (required)
# In PRODUCTION these MUST be unique, >= 32 chars, and NOT these example values,
# or the server will refuse to start. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
ACCESS_TTL=15m                       # access-token lifetime (e.g. 15m, 1h)
REFRESH_TTL=7d                       # refresh-token lifetime (e.g. 7d, 30d)

# CORS — comma-separated list of allowed browser origins.
# In production this is the ONLY allowlist (the localhost wildcard is dev-only),
# so set it to your real frontend origin(s), e.g. https://app.kodingkeydzz.com
CLIENT_ORIGINS=http://localhost:5175,http://localhost:5176

# Feature flags (default OFF; set to "true" to enable) --------------------------
# Public student self-registration. Off by default — org admins provision
# students (single add or Excel bulk upload). See src/routes/authRoutes.js.
ALLOW_STUDENT_SIGNUP=false
# Server-side code execution for the playground. Off by default — the Playground
# now runs code client-side (in the browser). Enabling this re-opens a local
# child_process execution surface, so only enable it behind a real sandbox.
ENABLE_SERVER_CODE_EXEC=false

# Where code may be executed. DEFAULT IS 'local' — nothing leaves this machine.
#   local  (default) this machine only. Never calls out.
#   auto            this machine, then Piston (a THIRD-PARTY service at
#                   emkc.org) if no local interpreter is found.
#   piston          the third-party service only.
#
# 'auto' and 'piston' send code to somebody else's server. Even then, only the
# playground may use them: final-test marking passes allowRemote:false and
# always will, so an exam answer never leaves this machine.
# CODE_RUNNER=local

# External grading for open-ended tasks (optional, OFF unless both are set).
#
# Some tasks cannot be graded by structural checks — "explain your choices" has
# no tag to look for. When these are set AND a question opts in with its own
# rubric, the pupil's answer and that rubric are sent to this endpoint. Nothing
# identifying about the child is sent.
#
# Both are required, and the question must opt in too: sending examined work to
# a third party is a decision, so the safe path is what you get by doing
# nothing. A failure here never costs a pupil marks — the answer is flagged for
# a teacher instead.
# TASK_VALIDATOR_URL=https://your-grader.example/score
# TASK_VALIDATOR_API_KEY=

# Error tracking (optional). When set, the central error handler emits a
# structured record for each 5xx. Integration point for @sentry/node (full APM).
# See DEPLOYMENT.md → Monitoring & Backups.
SENTRY_DSN=

# Cloudinary (optional) — uploads return a graceful 503 until these are set.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---------------------------------------------------------------------------
# Redis — ONLY needed to run more than one API instance.
#
# Socket.IO stores its rooms in one process's memory. With two instances and no
# shared backplane, a notification emitted on instance A never reaches a pupil
# connected to instance B: the emit finds no room and vanishes, with nothing
# logged. Setting this attaches the Socket.IO Redis adapter so every room emit
# crosses instances.
#
# Startup FAILS if this is set but unreachable — silently falling back to the
# in-memory adapter would look like a working deployment while dropping half
# the notifications.
#
# Also enable sticky sessions at the load balancer (nginx `ip_hash`), which
# Socket.IO requires for its long-polling fallback. See DEPLOYMENT.md.
# Leave BLANK for a single instance.
# REDIS_URL=redis://redis:6379

# Optional label for this instance, used only to make log lines readable.
# INSTANCE_ID=api-1
