# ---------------------------------------------------------------------------
# Koding Keydzz Backend — environment configuration
# Copy this file to `.env` and fill in real values. Vars marked (required) must
# be set or the server refuses to boot (see src/config/env.js).
# ---------------------------------------------------------------------------

# App
NODE_ENV=development                 # development | production | test
PORT=5000                            # HTTP port the API listens on

# Database (required)
MONGO_URI=mongodb://127.0.0.1:27017/koding_keydzz
# Optional DB connection tuning (read in src/config/db.js):
# MONGO_MAX_RETRIES=5                 # connection attempts before giving up
# MONGO_DNS_FALLBACK=on               # set to "off" to disable public-DNS SRV fallback

# Auth / JWT (required)
# In PRODUCTION these MUST be unique, >= 32 chars, and NOT these example values,
# or the server will refuse to start. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
ACCESS_TTL=15m                       # access-token lifetime (e.g. 15m, 1h)
REFRESH_TTL=7d                       # refresh-token lifetime (e.g. 7d, 30d)

# CORS — comma-separated list of allowed browser origins.
# In production this is the ONLY allowlist (the localhost wildcard is dev-only),
# so set it to your real frontend origin(s), e.g. https://app.kodingkeydzz.com
CLIENT_ORIGINS=http://localhost:5175,http://localhost:5176

# Feature flags (default OFF; set to "true" to enable) --------------------------
# Public student self-registration. Off by default — org admins provision
# students (single add or Excel bulk upload). See src/routes/authRoutes.js.
ALLOW_STUDENT_SIGNUP=false
# Server-side code execution for the playground. Off by default — the Playground
# now runs code client-side (in the browser). Enabling this re-opens a local
# child_process execution surface, so only enable it behind a real sandbox.
ENABLE_SERVER_CODE_EXEC=false

# Playground code execution strategy (only used if ENABLE_SERVER_CODE_EXEC=true):
# auto (default) | local | piston
# CODE_RUNNER=auto

# Error tracking (optional). When set, the central error handler emits a
# structured record for each 5xx. Integration point for @sentry/node (full APM).
# See DEPLOYMENT.md → Monitoring & Backups.
SENTRY_DSN=

# Cloudinary (optional) — uploads return a graceful 503 until these are set.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
