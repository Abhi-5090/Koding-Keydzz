# ─────────────────────────────────────────────────────────────────────────────
# Koding Keydzz — root environment for docker-compose.
# Copy to .env and fill in real values:  cp .env.example .env
# This file is consumed by docker-compose.yml (env_file: .env) and passed to the
# backend container, plus a few compose-only variables for the mongo service.
# ─────────────────────────────────────────────────────────────────────────────

# ---- MongoDB (compose service credentials) ----
# BOTH are REQUIRED — docker-compose refuses to start without them. There is no
# longer a fallback password ("example"), because an operator who never set it
# shipped a database with a publicly known root password. The mongo service is
# also no longer published to the host: it is reachable only on the compose
# network.
MONGO_ROOT_USERNAME=root
# Generate with: openssl rand -base64 32
MONGO_ROOT_PASSWORD=
MONGO_DB=koding_keydzz

# Connection string the backend uses INSIDE docker compose (service name "mongo").
# For MongoDB Atlas instead, use the SRV string Atlas gives you, e.g.:
#   MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/koding_keydzz?retryWrites=true&w=majority
# Leave BLANK to have compose build it from MONGO_ROOT_USERNAME/PASSWORD above.
MONGO_URI=

# ---- Backend ----
PORT=5000
NODE_ENV=production

# JWT secrets — generate each SEPARATELY with: openssl rand -hex 32
# The app refuses to boot in production if either is short, a known example
# value, or if the two are identical.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TTL=15m
REFRESH_TTL=7d

# ---- Seed bootstrap credentials ----
# REQUIRED the first time you seed a production database. The seed creates the
# superadmin and demo-admin accounts with these passwords and REFUSES to create
# them in production without strong values. It never changes the password of an
# account that already exists, so re-seeding after a content update is safe.
#   SEED_SUPERADMIN_PASSWORD="$(node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))")"
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=
# Optional: override the bootstrap account emails.
# SEED_SUPERADMIN_EMAIL=owner@yourdomain.com
# SEED_ADMIN_EMAIL=admin@yourdomain.com

# ---- Error tracking (strongly recommended in production) ----
# Without this, errors only reach stdout — nothing aggregates them and nothing
# alerts anyone. See src/config/monitoring.js.
SENTRY_DSN=

# ---- Rate limits ----
# A SCHOOL SITS BEHIND ONE PUBLIC IP. The sign-in limit was originally 30 per
# 15 minutes per IP, which meant the 31st pupil in a class could not log in and
# a whole school signing in at 9am locked itself out. Defaults are now sized
# for that reality; raise them further for a large school behind a single NAT.
#
# Brute-force protection does NOT depend on these: the per-account lockout
# (5 wrong passwords -> 15 minute lock) is independent of source IP.
# AUTH_RATE_LIMIT_MAX=600           # sign-ins per IP per window
# AUTH_RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
# API_RATE_LIMIT_MAX=3000           # general API calls per IP per minute
#
# These are keyed per USER rather than per IP, so they are safe to leave alone:
# GAME_COMPLETE_RATE_LIMIT_MAX=30
# PLAYGROUND_RATE_LIMIT_MAX=20
# UPLOAD_RATE_LIMIT_MAX=20

# ---- Feature flags ----
# Public student self-registration. Leave OFF: students are provisioned by
# their school's admin.
# ALLOW_STUDENT_SIGNUP=false
#
# DANGER — server-side code execution. Leave OFF (the default). The Playground
# runs student code entirely in the browser, so the server never spawns an
# interpreter. Turning this on re-enables raw child_process execution of
# arbitrary student code with NO sandbox, which is remote code execution on
# your API host. If you enable it, put a real sandbox in front first
# (self-hosted Piston, or a jailed container with seccomp + resource limits).
# ENABLE_SERVER_CODE_EXEC=false

# Comma-separated allowed CORS origins, no trailing slash (student app, admin app,
# prod domains). Local Vite dev servers run on 5175 (student) and 5176 (admin).
# Production example:
#   CLIENT_ORIGINS=https://app.kodingkeydzz.com,https://admin.kodingkeydzz.com
CLIENT_ORIGINS=http://localhost:5175,http://localhost:5176

# ---- Cloudinary (media uploads) ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─────────────────────────────────────────────────────────────────────────────
# Frontend build-time env (set in Vercel project settings, NOT in this compose
# .env — kept here only as documentation):
#   VITE_API_URL=https://api.your-domain.com/api/v1   (student + admin)
#   When served behind the bundled nginx proxy, use a same-origin path instead:
#   VITE_API_URL=/api/v1
# ─────────────────────────────────────────────────────────────────────────────
