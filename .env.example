# ─────────────────────────────────────────────────────────────────────────────
# Koding Keydzz — root environment for docker-compose.
# Copy to .env and fill in real values:  cp .env.example .env
# This file is consumed by docker-compose.yml (env_file: .env) and passed to the
# backend container, plus a few compose-only variables for the mongo service.
# ─────────────────────────────────────────────────────────────────────────────

# ---- MongoDB (compose service credentials) ----
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change_me_strong_password
MONGO_DB=koding_keydzz

# Connection string the backend uses INSIDE docker compose (service name "mongo").
# For MongoDB Atlas instead, use the SRV string Atlas gives you, e.g.:
#   MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/koding_keydzz?retryWrites=true&w=majority
MONGO_URI=mongodb://root:change_me_strong_password@mongo:27017/koding_keydzz?authSource=admin

# ---- Backend ----
PORT=5000
NODE_ENV=production

# JWT secrets — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
ACCESS_TTL=15m
REFRESH_TTL=7d

# Comma-separated allowed CORS origins, no trailing slash (student app, admin app,
# prod domains). Local Vite dev servers run on 5175 (student) and 5176 (admin).
# Production example:
#   CLIENT_ORIGINS=https://app.kodingkeydzz.com,https://admin.kodingkeydzz.com
CLIENT_ORIGINS=http://localhost:5175,http://localhost:5176

# ---- Cloudinary (media uploads) ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─────────────────────────────────────────────────────────────────────────────
# Frontend build-time env (set in Vercel project settings, NOT in this compose
# .env — kept here only as documentation):
#   VITE_API_URL=https://api.your-domain.com/api/v1   (student + admin)
#   When served behind the bundled nginx proxy, use a same-origin path instead:
#   VITE_API_URL=/api/v1
# ─────────────────────────────────────────────────────────────────────────────
